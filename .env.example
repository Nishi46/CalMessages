# Local dev only. Copy to .env and fill in — .env is gitignored, never commit real values.
# Matches infra/docker-compose.yml's default credentials.

DATABASE_URL_CONSUMER=postgresql://tally:tally_dev@localhost:5432/tally_consumer
DATABASE_URL_CLINIC=postgresql://tally:tally_dev@localhost:5433/tally_clinic
REDIS_URL=redis://localhost:6379

# apps/api
PORT=3000
# Used to reconstruct the exact URL for Twilio signature verification — never
# inferred from the request, since a proxy in front of this service can't be
# trusted to report the right protocol/host (see apps/api/README.md).
PUBLIC_BASE_URL=http://localhost:3000

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tally-dev-media
S3_ACCESS_KEY_ID=tally
S3_SECRET_ACCESS_KEY=tally_dev_secret

# Filled in once the Twilio account + A2P registration exist — see infra/README.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Filled in once the Stripe account exists.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Filled in once a vision provider is chosen (04 §1, §5.1).
VISION_PROVIDER_API_KEY=

# Managed with a narrower access list than the vars above, per 04 §13 —
# reserved now even though packages/db-clinic has no schema yet.
CLINIC_FIELD_ENCRYPTION_KEY=

# apps/worker
# Optional — defaults to 15 minutes (04 §7.1) if unset. Override for local
# testing rather than waiting on the real interval.
SCHEDULER_TICK_MS=
